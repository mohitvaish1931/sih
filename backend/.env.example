# =============================================================================
# SIFRA backend configuration
# Copy to .env (never commit .env) and fill in. Every value has a safe default.
# On Render / Railway set the same keys in the dashboard instead of a file.
# =============================================================================

# --- Database -----------------------------------------------------------------
# Leave empty for a local SQLite file (./test.db). For Postgres use the full URL.
#   Neon:     postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require
#   Supabase: postgresql://postgres.PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres
# Use the *pooler* host on Render / Railway (IPv4-only hosts).
# (SUPABASE_DB_URL is still accepted as an alias for older setups.)
DATABASE_URL=

# --- API ----------------------------------------------------------------------
# Comma-separated origins allowed to call the API. "*" = anyone.
# Production example: https://sifra.vercel.app,http://localhost:5173
CORS_ORIGINS=*

# --- Blockchain sync ----------------------------------------------------------
SYNC_MAX_TXS=150          # most recent transactions analysed per address
SYNC_TTL_SECONDS=600      # re-sync an address after this many seconds
HTTP_TIMEOUT=8            # seconds per blockchain API request

# --- Entity attribution (WalletExplorer) --------------------------------------
ENTITY_LOOKUP_WORKERS=8
ENTITY_LOOKUP_TIMEOUT=3
ENTITY_LOOKUP_BUDGET=4    # max seconds spent on live lookups per investigation
ENTITY_LOOKUP_MAX=60

# --- ML -----------------------------------------------------------------------
# Sample ~80 live mainnet addresses at startup as the anomaly reference population
# (runs once in the background, ~3-4 min, stored in the database).
ML_LIVE_REFERENCE=true

# --- Local LLM narrative (optional, Ollama) -----------------------------------
# Without Ollama SIFRA uses the deterministic evidence template. Set false on cloud hosts.
LLM_ENABLED=true
OLLAMA_URL=http://127.0.0.1:11434/api/generate
OLLAMA_MODEL=qwen3:14b
OLLAMA_TIMEOUT=20

# --- Relay telemetry ----------------------------------------------------------
GEOIP_ENABLED=true
# Shared secret the relay sensor must send (X-Sifra-Token). Set one in production;
# run the sensor with:  TELEMETRY_TOKEN=... python sensor/relay_sensor.py --api https://your-api
TELEMETRY_TOKEN=
