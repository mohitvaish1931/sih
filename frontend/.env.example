# =============================================================================
# SIFRA frontend configuration (Vite). Copy to .env.local for local overrides.
# On Vercel set these under Project -> Settings -> Environment Variables.
# =============================================================================

# Base URL of the SIFRA API. The /api suffix is optional (added automatically).
# Leave unset locally: the dev server proxies /api to http://127.0.0.1:8000.
# Production example (Render): https://sifra-api.onrender.com
VITE_API_BASE=

# Dev-server only: where `npm run dev` proxies /api (default http://127.0.0.1:8000)
# SIFRA_API_PROXY=http://127.0.0.1:8000
